# A TestNet account holding TestNet USDC (ASA 10458941). This is the only
# required value. It signs payments; it is never sent anywhere but your own
# algod node, and AlgoTerminal never sees it.
#
#   1. Create an account and fund it with TestNet ALGO:
#      https://bank.testnet.algorand.network
#   2. Opt it in to ASA 10458941, then claim TestNet USDC:
#      https://faucet.circle.com  (select Algorand TestNet)
TESTNET_PAYER_MNEMONIC="twenty five words separated by single spaces"

# Optional. Defaults to the public AlgoTerminal TestNet deployment.
# ALGOTERMINAL_BASE_URL=https://api-testnet-production-a3ec.up.railway.app

# Optional. Algod used to BUILD the payment transaction. Note this is TestNet,
# because that is the chain the payment settles on — the DATA AlgoTerminal
# serves is Algorand MainNet, which is a different chain entirely.
# ALGOD_URL=https://testnet-api.4160.nodely.dev
