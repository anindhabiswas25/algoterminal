# algoterminal-mcp — copy to .env for local development, or set these in your
# MCP client's config (claude_desktop_config.json / .mcp.json) instead.

# ---------------------------------------------------------------------------
# Your payment key. Required for the paid tools; the free tools work without it.
# ---------------------------------------------------------------------------
# The 25-word mnemonic of an Algorand account YOU control, holding USDC. It signs
# payments, it goes to your algod node to build a transaction and nowhere else,
# and AlgoTerminal never sees it. This server ships no funded account and pays on
# nobody's behalf.
#
# On TestNet the money is free:
#   1. Fund the account with TestNet ALGO: https://bank.testnet.algorand.network
#   2. Opt it in to USDC, ASA 10458941 — MANDATORY. An account that is not opted
#      in cannot hold the asset and every payment fails. Verify on chain:
#      curl -s "https://testnet-api.4160.nodely.dev/v2/accounts/<ADDR>" \
#        | jq '.assets[] | select(."asset-id" == 10458941)'
#      A record with "amount": 0 is the pass condition.
#   3. Get TestNet USDC. faucet.circle.com is often rate-limited; swapping a
#      little TestNet ALGO on a Tinyman V2 TestNet pool is the reliable path.
ALGOTERMINAL_MNEMONIC="twenty five words separated by single spaces"

# Or keep it out of the config file entirely. Prefer this, with mode 0600.
# ALGOTERMINAL_KEYFILE=~/.algoterminal/payer.key

# ---------------------------------------------------------------------------
# Spend caps. Both are enforced against the amount the server quotes in its 402,
# before anything is signed. A call over either is refused, never truncated.
# ---------------------------------------------------------------------------
# Per MCP session; resets when the server restarts.
# ALGOTERMINAL_MAX_SPEND_USDC=1.00

# The default 0.05 is exactly the price of one /compare, so compare works and the
# expensive tiers (compare?fresh=true at 0.08, /ask at 0.15) are refused until
# you decide otherwise.
# ALGOTERMINAL_MAX_PER_CALL_USDC=0.05

# ---------------------------------------------------------------------------
# Network. The DATA is always Algorand MainNet; this is the chain the PAYMENT
# settles on. Two different things.
# ---------------------------------------------------------------------------
# ALGOTERMINAL_NETWORK=testnet

# Defaults to the public TestNet deployment. Required if NETWORK=mainnet, which
# has no default deployment yet.
# ALGOTERMINAL_BASE_URL=https://api-testnet-production-a3ec.up.railway.app

# Algod used to BUILD the payment transaction — not to read AlgoTerminal's data.
# ALGOTERMINAL_ALGOD_URL=https://testnet-api.4160.nodely.dev

# ALGOTERMINAL_TIMEOUT_MS=60000
