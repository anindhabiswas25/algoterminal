# AlgoTerminal — environment (DEPLOYMENT.md §3)
# Copy to .env for local development. Every var below is validated by
# src/config/env.ts at boot; the service refuses to start if any is malformed.

NODE_ENV=development                                  # development | test | production
PORT=3000                                             # HTTP listen port (Railway injects its own)

X402_NETWORK=testnet                                  # mainnet | testnet — selects CAIP-2 id and USDC ASA
# 58-char Algorand address that receives payment (DEPLOYMENT.md §2). Validated at
# boot for BOTH its alphabet and its trailing checksum: a transposed address is
# well-formed to look at and cannot receive anything, and the first symptom would
# be a failed payment rather than a failed boot.
X402_PAYTO=
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz             # GoPlausible facilitator that verifies and settles

ALGOD_URL=https://mainnet-api.4160.nodely.dev         # algod for CONNECTOR reads. Always mainnet: the protocols
INDEXER_URL=https://mainnet-idx.4160.nodely.dev       # we measure live there, whatever chain payments settle on.
                                                      # The x402 gate does NOT read these — it derives its own
                                                      # algod/indexer from X402_NETWORK (src/config/x402.ts).
                                                      # Pointing these at testnet does not error, it under-reports:
                                                      # Tinyman's V2 walk returns 0 pools. See DEPLOYMENT.md §3.

# REQUIRED as of the cache (step 5): Redis is L1 + the stampede lock, Postgres is L2.
# The service refuses to boot without them rather than serving every call from a
# 70s upstream fetch, which is unprofitable at $0.005 (ARCHITECTURE.md §4.5).
REDIS_URL=redis://localhost:6379                      # ${{Redis.REDIS_URL}} on Railway
DATABASE_URL=postgres://localhost:5432/algoterminal   # ${{Postgres.DATABASE_URL}} on Railway
# ANTHROPIC_API_KEY=sk-ant-...                        # Claude key for /ask routing and synthesis.
#                                                     # Optional: a deployment without it serves every
#                                                     # other route normally and simply does not gate,
#                                                     # advertise or sell POST /ask.

# Comma-separated Algorand addresses that belong to US — the mainnet payTo and
# any test buyer. DEPLOYMENT.md §7.2's second query ("our own addresses must
# never appear") runs weekly against this list and raises an ALARM on any hit;
# the result is published on /health. Leave it unset and /health reports
# own_addresses_configured: false rather than a clean bill of health.
# OWN_PAYER_ADDRESSES=ADDR1,ADDR2

METHODOLOGY_VERSION=1.2.0                             # semver; bumped when a formula changes (API_SPEC.md §5)
PUBLIC_BASE_URL=http://localhost:3000                 # canonical external base URL, used in 402s and llms.txt
# TESTNET_BASE_URL=https://api-testnet-production-a3ec.up.railway.app
                                                      # Optional. The free evaluation surface advertised on
                                                      # /llms.txt and the landing page (PRD.md §7.5). Set it on
                                                      # the MAINNET service; the testnet service leaves it unset,
                                                      # having nothing to point at but itself.
LOG_LEVEL=info                                        # fatal | error | warn | info | debug | trace | silent

# --- Scripts only. Never read by the server. -------------------------------
# `npm run testnet:accounts` opts these in to USDC and reports what needs funding;
# `npm run testnet:smoke` spends from the payer. Keep them out of any deployed
# environment: the API never needs a private key, because it only ever receives.
# TESTNET_PAYTO_MNEMONIC="twenty five words ..."
# TESTNET_PAYER_MNEMONIC="twenty five words ..."
# SMOKE_BASE_URL=https://api-testnet-production-a3ec.up.railway.app
# SMOKE_DATABASE_URL=postgresql://...   # optional; lets the smoke test count payments rows directly
